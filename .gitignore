# ============================================================
# .gitignore — Radar de Riesgo Farmacéutico Perú-FDA
# ============================================================

# --- Entorno virtual y dependencias ---
.venv/
venv/
env/
.env
*.egg-info/
dist/
build/

# --- Caché de Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Pytest y cobertura ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Data Lake: archivos de entrada (pesados, no se versionan) ---
data/raw/
data/processed/
*.parquet
*.sqlite
*.db

# --- Datos sintéticos de prueba (ZIPs pesados) ---
docs/datos_sinteticos/*.zip

# --- Logs y modelos ---
logs/
*.log
models/

# --- Documentos privados / Informe institucional y bitácora ---
docs/informe/
*.docx
*.xlsx

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.ipynb_checkpoints/

