# ============================================================
# Radar de Riesgo Farmacéutico Perú-FDA — Variables de entorno
# Copia este archivo como .env y ajusta los valores locales.
# NUNCA versiones el .env real (está en .gitignore).
# ============================================================

# Ruta personalizada para la base de datos SQLite (opcional)
# Si se omite, se usa data/processed/radar_farmacovigilancia.db
# SQLITE_DB_PATH=data/processed/radar_farmacovigilancia.db

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Umbrales epidemiológicos (sólo si se quieren sobreescribir los valores por defecto)
# PRR_THRESHOLD_HIGH=2.0
# PRR_THRESHOLD_MED=1.5
# CHI2_THRESHOLD_HIGH=4.0
# CHI2_THRESHOLD_MED=3.0
